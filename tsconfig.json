{
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "esnext",
        "types": [
            "node",
            "@wdio/globals/types",
            "@wdio/cucumber-framework"
        ],
        "sourceMap": true,
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true
    },
    "include": ["src/**/*.ts", "features/**/*.ts", "*.ts"]

}